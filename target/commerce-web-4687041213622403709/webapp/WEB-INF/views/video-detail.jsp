<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="vi_VN" />
<!doctype html><html lang="vi"><head><title>Chi tiết video</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/video-commerce.css"></head><body>
<nav class="breadcrumb" aria-label="Đường dẫn"><a href="${pageContext.request.contextPath}/home">Trang chủ</a><span>/</span><span><c:out value="${video.category.categoryName}"/></span></nav>
<div class="detail-layout"><article><div class="cinema-stage"><img src="<c:out value='${video.poster}'/>" alt="<c:out value='${video.title}'/>"><span class="badge stage-label">Ảnh giới thiệu video</span></div><div class="detail-heading"><span class="badge"><c:out value="${video.category.categoryName}"/></span><h1><c:out value="${video.title}"/></h1><div class="stats"><span>◉ ${video.views} lượt xem</span><span>♡ ${likes} lượt thích</span><span>↗ ${shares} lượt chia sẻ</span></div></div><section class="panel description"><h2>Giới thiệu video</h2><p><c:out value="${video.description}" default="Chưa có mô tả cho video này."/></p></section></article>
<aside class="panel video-info"><p class="eyebrow">THÔNG TIN VIDEO</p><h2>Chi tiết nội dung</h2><dl class="detail-list"><dt>Mã video</dt><dd><c:out value="${video.videoId}"/></dd><dt>Danh mục</dt><dd><c:out value="${video.category.categoryName}"/></dd><dt>Lượt xem</dt><dd>${video.views}</dd><dt>Lượt thích</dt><dd>${likes}</dd><dt>Lượt chia sẻ</dt><dd>${shares}</dd></dl><c:if test="${not empty product}"><section class="video-offer"><p>Giá video</p><strong><fmt:formatNumber value="${product.price}" maxFractionDigits="0"/> ₫</strong><span>${product.stock > 0 ? 'Đang mở bán' : 'Đã hết lượt bán'}</span><c:if test="${product.stock > 0}"><c:choose><c:when test="${empty sessionScope.user}"><a class="button" href="${pageContext.request.contextPath}/login">Đăng nhập để mua</a></c:when><c:otherwise><form action="${pageContext.request.contextPath}/cart" method="post"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="revision" value="${revision}"><input type="hidden" name="action" value="add"><input type="hidden" name="productId" value="${product.id}"><input type="hidden" name="quantity" value="1"><button type="submit">＋ Thêm video vào giỏ</button></form></c:otherwise></c:choose></c:if></section></c:if><a class="button secondary" href="${pageContext.request.contextPath}/home">← Quay lại kho video</a></aside></div>
</body></html>
