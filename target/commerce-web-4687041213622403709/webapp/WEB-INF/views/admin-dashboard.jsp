<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="vi_VN"/>
<!doctype html><html lang="vi"><head><title>Tổng quan quản trị</title></head><body>
<div class="dashboard-heading"><div><p class="eyebrow">▦ TRUNG TÂM KIỂM SOÁT SỐ LIỆU</p><h1>Tổng quan &amp; Báo cáo<br>Hiệu năng Hệ thống</h1><p class="muted">Theo dõi kho video, người dùng và mức độ tương tác trên VidStream.</p></div><div class="dashboard-period"><span class="badge">Toàn bộ thời gian</span><a class="button secondary" href="${pageContext.request.contextPath}/admin">↻ Cập nhật số liệu</a></div></div>
<section class="metric-grid" aria-label="Thống kê tổng quan">
<article class="metric-card"><div class="metric-label">TÀI KHOẢN ĐÃ ĐĂNG KÝ <span>♙</span></div><strong class="metric-value"><fmt:formatNumber value="${dashboard.users}"/></strong><p class="muted">Tổng số tài khoản trong hệ thống</p><div class="metric-accent"></div></article>
<article class="metric-card"><div class="metric-label">TỔNG LƯỢT XEM <span>▷</span></div><strong class="metric-value"><fmt:formatNumber value="${dashboard.views}"/></strong><p class="muted">Lượt xem tích lũy của tất cả video</p><div class="metric-accent"></div></article>
<article class="metric-card"><div class="metric-label">KHO VIDEO <span>▤</span></div><strong class="metric-value"><fmt:formatNumber value="${dashboard.videos}"/></strong><p class="muted">${dashboard.published} hiển thị · ${dashboard.videos-dashboard.published} đang ẩn</p><div class="metric-accent"></div></article>
<article class="metric-card"><div class="metric-label">TƯƠNG TÁC <span>♡</span></div><strong class="metric-value"><fmt:formatNumber value="${dashboard.likes+dashboard.shares}"/></strong><p class="muted">${dashboard.likes} lượt thích · ${dashboard.shares} lượt chia sẻ</p><div class="metric-accent"></div></article>
</section>
<c:set var="maxViews" value="0"/><c:forEach var="row" items="${dashboard.categories}"><c:if test="${row[2]>maxViews}"><c:set var="maxViews" value="${row[2]}"/></c:if></c:forEach>
<section class="panel dashboard-chart"><div class="section-title"><div><h2>Lượt xem video theo danh mục</h2><p class="muted">Tổng lượt xem tích lũy, bao gồm video hiển thị và đang ẩn.</p></div><span class="chart-key">● Lượt xem</span></div>
<c:choose><c:when test="${empty dashboard.categories}"><p class="empty-state muted">Chưa có danh mục để thống kê.</p></c:when><c:otherwise><div class="bar-chart" role="list" aria-label="Lượt xem theo danh mục"><c:forEach var="row" items="${dashboard.categories}"><div class="chart-column" role="listitem"><strong><fmt:formatNumber value="${row[2]}"/></strong><div class="chart-track"><div class="chart-bar" style="height:${maxViews>0?row[2]*100.0/maxViews:0}%"></div></div><span><c:out value="${row[0]}"/></span></div></c:forEach></div></c:otherwise></c:choose>
</section>
<div class="dashboard-lower"><section class="panel dashboard-ranking"><div class="section-title"><div><h2>Top 5 video nhiều lượt xem</h2><p class="muted">Xếp hạng theo tổng lượt xem tích lũy.</p></div><a href="${pageContext.request.contextPath}/admin/videos">Quản lý video ↗</a></div><div class="table-wrap"><table><thead><tr><th>Hạng</th><th>Nội dung video</th><th>Lượt xem</th><th>Trạng thái</th></tr></thead><tbody><c:forEach var="v" items="${dashboard.topVideos}" varStatus="rank"><c:url var="editUrl" value="/admin/videos"><c:param name="edit" value="${v.videoId}"/></c:url><tr><td><span class="rank-badge">${rank.count}</span></td><td><a class="rank-video" href="${editUrl}"><img class="thumb" src="<c:out value='${v.poster}'/>" alt="" loading="lazy"><span><strong><c:out value="${v.title}"/></strong><small><c:out value="${v.category.categoryName}"/> · <c:out value="${v.videoId}"/></small></span></a></td><td><fmt:formatNumber value="${v.views}"/></td><td><span class="status-pill ${v.active?'published':''}">${v.active?'Hiển thị':'Đang ẩn'}</span></td></tr></c:forEach><c:if test="${empty dashboard.topVideos}"><tr><td colspan="4" class="muted">Chưa có video. Thêm video mới để bắt đầu.</td></tr></c:if></tbody></table></div></section>
<aside class="dashboard-side"><section class="panel"><h2>Phân bố danh mục</h2><p class="muted">Số lượng video trong từng danh mục</p><c:forEach var="row" items="${dashboard.categories}"><div class="category-distribution"><div><span><c:out value="${row[0]}"/></span><strong>${row[1]}</strong></div><meter min="0" max="${dashboard.videos>0?dashboard.videos:1}" value="${row[1]}" aria-label="<c:out value='${row[0]}'/>">${row[1]}</meter></div></c:forEach><c:if test="${empty dashboard.categories}"><p class="muted">Chưa có danh mục.</p></c:if></section><section class="panel quick-actions"><p class="eyebrow">QUẢN LÝ NỘI DUNG</p><h2>Thao tác nhanh</h2><a href="${pageContext.request.contextPath}/admin/videos#video-form">＋ Thêm video mới <span>↗</span></a><a href="${pageContext.request.contextPath}/admin/videos">▤ Chỉnh sửa kho video <span>↗</span></a><a href="${pageContext.request.contextPath}/home">⌂ Xem trang người dùng <span>↗</span></a></section></aside></div>
</body></html>
